[Unit]
Description=sewer-api Docker container
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
# 경로는 실제 서버에서 프로젝트 위치로 수정하세요.
ExecStart=/usr/bin/docker run --name sewer-api --env-file /path/to/backend/.env -p 8000:8000 --restart unless-stopped sewer-api
ExecStop=/usr/bin/docker stop sewer-api || true
ExecStopPost=/usr/bin/docker rm sewer-api || true

[Install]
WantedBy=multi-user.target
